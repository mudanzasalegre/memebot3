PUMP_EARLY_SHADOW_RECOVERY_SCAN_MAX_ROWS=1000

# One executable paper lane. Its amount is exactly 0.1 SOL.
LANE_SIZING_ENABLED=true
LANE_SIZING_FIXED_TRADE_AMOUNT_ENABLED=false
PAPER_MAX_TRADE_AMOUNT_SOL=0.1
PAPER_BOOTSTRAP_AMOUNT_SOL=0.1
