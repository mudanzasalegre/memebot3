PRE_ENTRY_RISK_NEG_PRICE5M_EXCEPTION_MAX_MCAP_USD=250000
PRE_ENTRY_RISK_NEG_PRICE5M_EXCEPTION_MAX_PRICE_IMPACT_PCT=12
