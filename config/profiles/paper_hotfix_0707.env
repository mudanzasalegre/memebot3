# P0: finite caps. In current runtime, 0 means unlimited.
SHADOW_FOLLOWUP_MICRO_MAX_OPEN=2
SHADOW_FOLLOWUP_MICRO_MAX_DAILY_BUYS=8
PAPER_BOOTSTRAP_MAX_OPEN=2
PAPER_BOOTSTRAP_MAX_DAILY_BUYS=6
PAPER_BOOTSTRAP_MAX_HOURLY_BUYS=2
PAPER_BOOTSTRAP_MIN_SECONDS_BETWEEN_BUYS=600
