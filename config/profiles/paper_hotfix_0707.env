MOONSHOT_MICRO_LOTTERY_MAX_OPEN=1
MOONSHOT_MICRO_LOTTERY_MAX_DAILY_BUYS=10

# Quarantine every other paper-buy lane with negative or unvalidated expectancy.
PAPER_EXPLORATION_QUOTA_ENABLED=false
PAPER_IDLE_MICRO_EXPLORATION_ENABLED=false
PAPER_BOOTSTRAP_ENABLED=true
SHADOW_FOLLOWUP_MICRO_ENABLED=false
SHADOW_FOLLOWUP_REAL_LIQUIDITY_BREAKOUT_ENABLED=false
MOONSHOT_MICRO_LOTTERY_ENABLED=false
